    "minEngineVersion": "4.6.0",
    "maxEngineVersion": null,
    "filename": "simple-channel-history-{version}.zip",
    "restartRequired": true,
    "homepage": "https://github.com/diridium-com/simple-channel-history",
    "documentation": "https://github.com/diridium-com/simple-channel-history#readme",
    "storeDocs": "docs/store.md",
